<Application x:Class="Athena.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <!-- ATHENA palette: Obsidian & Bronze (matches the web interface). -->
    <SolidColorBrush x:Key="BrushBackground" Color="#0E0F11"/>
    <SolidColorBrush x:Key="BrushPanel" Color="#16181C"/>
    <SolidColorBrush x:Key="BrushCard" Color="#1B1E23"/>
    <SolidColorBrush x:Key="BrushGold" Color="#D4AF37"/>
    <SolidColorBrush x:Key="BrushOlive" Color="#4A6B5D"/>
    <SolidColorBrush x:Key="BrushText" Color="#F3F1EC"/>
    <SolidColorBrush x:Key="BrushMuted" Color="#9A9890"/>
    <SolidColorBrush x:Key="BrushUserBubble" Color="#2A2416"/>
    <SolidColorBrush x:Key="BrushError" Color="#7A2E2E"/>
    <!-- Frosted glass: translucent fills + light edges over black.
         Panels using these read as smoked glass; the fill is light
         at the top and darker at the bottom, with a thin bright edge. -->
    <LinearGradientBrush x:Key="BrushGlassFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#33FFFFFF" Offset="0"/>
      <GradientStop Color="#1FFFFFFF" Offset="0.5"/>
      <GradientStop Color="#0DFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="BrushGlassBorder" Color="#59FFFFFF"/>
    <SolidColorBrush x:Key="BrushGlassGoldBorder" Color="#80D4AF37"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#D4AF37"/>
      <Setter Property="Foreground" Value="#0E0F11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#16181C"/>
      <Setter Property="Foreground" Value="#F3F1EC"/>
      <Setter Property="BorderBrush" Value="#3A3D42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
  </Application.Resources>
</Application>
