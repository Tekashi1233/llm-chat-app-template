<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Building a Windows app from Linux needs this flag. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Athena</AssemblyName>
    <RootNamespace>Athena</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- One self-contained .exe: no .NET runtime to install on the laptop. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compress the bundled runtime: roughly halves the .exe size. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Athena.Core\Athena.Core.csproj" />
    <!-- The window Icon="icon.png" in MainWindow.xaml resolves this as a
         WPF resource at runtime. It must be a PNG: the ICO PIL wrote was
         PNG-compressed throughout and WPF's decoder rejects it, which
         crashed the app on launch (N1 fix 2). icon.ico stays as the exe's
         native icon (ApplicationIcon) — it is now a classic BMP/DIB ICO,
         which Explorer decodes fine. -->
    <Resource Include="icon.png" />
  </ItemGroup>

</Project>
