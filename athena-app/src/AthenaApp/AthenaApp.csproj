<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Building a Windows app from Linux needs this flag. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Athena</AssemblyName>
    <RootNamespace>Athena</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- One self-contained .exe: no .NET runtime to install on the laptop. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compress the bundled runtime: roughly halves the .exe size. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Athena.Core\Athena.Core.csproj" />
    <!-- The window Icon="icon.ico" in MainWindow.xaml resolves this as a
         WPF resource at runtime. Without this line the file is only the
         exe's native icon (ApplicationIcon) and the window fails to load. -->
    <Resource Include="icon.ico" />
  </ItemGroup>

</Project>
