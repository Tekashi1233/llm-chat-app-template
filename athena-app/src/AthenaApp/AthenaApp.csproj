<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Building a Windows app from Linux needs this flag. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Athena</AssemblyName>
    <RootNamespace>Athena</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- One self-contained .exe: no .NET runtime to install on the laptop. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Compress the bundled runtime: roughly halves the .exe size. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- NEVER set InvariantGlobalization here: WPF needs real
         globalization data at window load (it resolves the system UI
         culture, e.g. 1033 en-US). With invariant mode on, the app
         crashes on launch with "Only the invariant culture is
         supported in globalization-invariant mode". The price of
         leaving it off is a bigger .exe (ICU data is bundled). -->
  </PropertyGroup>

  <ItemGroup>
    <!-- N7: tray icon needs System.Windows.Forms.NotifyIcon. A plain
         FrameworkReference, NOT <UseWindowsForms>true</UseWindowsForms>:
         that flag also adds global usings for System.Drawing and
         System.Windows.Forms, which make Color/Button/Brush/UserControl
         ambiguous in every WPF file. MainWindow reaches WinForms
         through its explicit `using WinForms = ...` alias instead. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Athena.Core\Athena.Core.csproj" />
    <!-- N4 voice: SAPI via System.Speech 8.0.0 (net8.0-windows).
         The .nupkg lives in ~/nuget-local/; restore uses the
         local-only NuGet source because nuget.org hangs through
         this VM's proxy. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <!-- The window Icon="icon.png" in MainWindow.xaml resolves this as a
         WPF resource at runtime. It must be a PNG: the ICO PIL wrote was
         PNG-compressed throughout and WPF's decoder rejects it, which
         crashed the app on launch (N1 fix 2). icon.ico stays as the exe's
         native icon (ApplicationIcon) — it is now a classic BMP/DIB ICO,
         which Explorer decodes fine. -->
    <Resource Include="icon.png" />
  </ItemGroup>

</Project>
