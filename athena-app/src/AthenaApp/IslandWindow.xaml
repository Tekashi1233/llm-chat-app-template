<Window x:Class="Athena.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATHENA Island" Width="240" Height="56"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Icon="icon.png">
  <!--
    N3 Dynamic Island: a floating pill, not a browser overlay.
    Compact: gold disc + one status line. Expanded (single click):
    status + last reply snippet + Open Centre / Hide buttons.
    It never activates itself (ShowActivated=False) and never
    steals focus — state changes come only from real app events.
  -->
  <Border x:Name="PillBorder" Background="{StaticResource BrushPanel}"
          BorderBrush="{StaticResource BrushGold}" BorderThickness="1"
          CornerRadius="28" Padding="10,0,14,0"
          MouseLeftButtonDown="PillBorder_MouseLeftButtonDown">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem x:Name="AlwaysOnTopItem" Header="Always on top"
                  IsCheckable="True" IsChecked="True"
                  Click="AlwaysOnTopItem_Click"/>
        <MenuItem Header="Open Command Centre" Click="OpenCentreItem_Click"/>
        <MenuItem Header="Hide Island" Click="HideItem_Click"/>
      </ContextMenu>
    </Border.ContextMenu>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Compact row -->
      <Grid Grid.Row="0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0">
          <Ellipse x:Name="Disc" Fill="{StaticResource BrushGold}"/>
          <TextBlock Text="A" FontFamily="Georgia" FontWeight="Bold"
                     FontSize="13" Foreground="#0E0F11"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Idle"
                   FontSize="13" Foreground="{StaticResource BrushText}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>

      <!-- Expanded panel -->
      <StackPanel x:Name="ExpandedPanel" Grid.Row="1"
                  Visibility="Collapsed" Margin="0,0,0,10">
        <Border Height="1" Background="{StaticResource BrushGold}"
                Opacity="0.35" Margin="0,0,0,8"/>
        <TextBlock x:Name="SnippetText" FontSize="12"
                   Foreground="{StaticResource BrushMuted}"
                   TextWrapping="Wrap" MaxHeight="64"
                   TextTrimming="CharacterEllipsis"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Content="Open Centre" Padding="10,4"
                  Click="OpenCentreButton_Click"/>
          <Button Content="Hide" Padding="10,4" Margin="8,0,0,0"
                  Click="HideButton_Click"/>
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
