<Window x:Class="Athena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ATHENA" Height="700" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="#000000"
        WindowStyle="None"
        Icon="icon.png">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="34" CornerRadius="0"
                        GlassFrameThickness="0" ResizeBorderThickness="6"/>
  </shell:WindowChrome.WindowChrome>
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions>
      <RowDefinition Height="34"/>
      <RowDefinition x:Name="WordmarkRow" Height="*"/>
      <RowDefinition x:Name="ChatRow" Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Glass title bar (custom chrome): icon + ATHENA on the left,
         minimize / maximize / close on the right. Dragging and
         double-click-to-maximize are handled by the OS caption
         (CaptionHeight 34); the buttons are hit-test visible in
         the chrome so they stay clickable. -->
    <Grid Grid.Row="0" Background="{StaticResource BrushGlassFill}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Image Source="icon.png" Width="16" Height="16" Margin="12,0,8,0"
             VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="A T H E N A" FontFamily="Georgia"
                 FontSize="13" FontWeight="Bold" Foreground="#EDEDE8"
                 VerticalAlignment="Center"/>
      <Button Grid.Column="2" Content="—" Click="MinimizeButton_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="Transparent" Foreground="#9A9890"
              BorderThickness="0" Padding="0" Width="46" Height="34"
              FontSize="13" ToolTip="Minimize"/>
      <Button Grid.Column="3" Content="▢" Click="MaximizeButton_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="Transparent" Foreground="#9A9890"
              BorderThickness="0" Padding="0" Width="46" Height="34"
              FontSize="13" ToolTip="Maximize"/>
      <Button Grid.Column="4" Content="✕" Click="CloseButton_Click"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Background="Transparent" Foreground="#E88A8A"
              BorderThickness="0" Padding="0" Width="46" Height="34"
              FontSize="13" ToolTip="Close"/>
      <Border Grid.ColumnSpan="5" BorderBrush="#33FFFFFF"
              BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
    </Grid>

    <!-- Wordmark zone: pure black, ATHENA in the centre, subtle red + blue light behind it. -->
    <Grid Grid.Row="1" x:Name="WordmarkZone" Background="#000000" ClipToBounds="True">
      <!-- Soft glows: radial gradients fading to transparent. No BlurEffect (GPU cost), no flashing. -->
      <Ellipse x:Name="BlueGlow" Width="560" Height="560"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="-200,0,200,0" Opacity="0.16">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#2E5AAC" Offset="0"/>
            <GradientStop Color="#2E5AAC" Offset="0.45"/>
            <GradientStop Color="#002E5AAC" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>
      <Ellipse x:Name="RedGlow" Width="560" Height="560"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Margin="200,0,-200,0" Opacity="0.16">
        <Ellipse.Fill>
          <RadialGradientBrush>
            <GradientStop Color="#A32E2E" Offset="0"/>
            <GradientStop Color="#A32E2E" Offset="0.45"/>
            <GradientStop Color="#00A32E2E" Offset="1"/>
          </RadialGradientBrush>
        </Ellipse.Fill>
      </Ellipse>

      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Arc reactor: ATHENA's identity. Concentric steel rings,
             a segmented coil ring, and a glowing blue-white core.
             It lights up bright when ATHENA replies, pulses gently
             while she thinks, and rests dim when idle. -->
        <Grid x:Name="Reactor" Width="260" Height="260"
              HorizontalAlignment="Center"
              MouseLeftButtonDown="Reactor_MouseLeftButtonDown"
              ToolTip="Click to return to the idle screen">
          <Ellipse x:Name="ReactorGlow" Width="420" Height="420"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Opacity="0.25">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#7FB3FF" Offset="0"/>
                <GradientStop Color="#2E5AAC" Offset="0.4"/>
                <GradientStop Color="#002E5AAC" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Stroke="#7A8A99" StrokeThickness="3"/>
          <Ellipse Margin="14" Stroke="#9FB4C7" StrokeThickness="12"
                   StrokeDashArray="10 7"/>
          <Ellipse Margin="38" Stroke="#5A6B7A" StrokeThickness="2"/>
          <Ellipse x:Name="ReactorCore" Margin="52" Opacity="0.55">
            <Ellipse.Fill>
              <RadialGradientBrush>
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#BFE0FF" Offset="0.35"/>
                <GradientStop Color="#2E5AAC" Offset="0.7"/>
                <GradientStop Color="#002E5AAC" Offset="1"/>
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Ellipse Width="26" Height="26" Fill="#FFFFFF"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="WordmarkText" Text="A T H E N A" FontFamily="Georgia"
                   FontSize="28" FontWeight="Bold"
                   Foreground="#EDEDE8" HorizontalAlignment="Center"
                   Margin="0,18,0,0"
                   MouseLeftButtonDown="WordmarkText_MouseLeftButtonDown"
                   ToolTip="Click to return to the idle screen"/>
        <TextBlock x:Name="StatusText" Text="Starting…" FontSize="11"
                   Foreground="#8A8A85" HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
        <!-- N8: the wake greeting as text, shown only when the
             wake word fires and speech is unavailable — it is a
             local line, never a chat message. Hidden otherwise. -->
        <TextBlock x:Name="GreetingText" Text="Welcome, boss." FontSize="13"
                   Foreground="#EDEDE8" HorizontalAlignment="Center"
                   Margin="0,6,0,0" Visibility="Collapsed"/>
      </StackPanel>

      <!-- Minimal menu, top right. -->
      <Button x:Name="MenuButton" Content="···" FontSize="20"
              Background="Transparent" Foreground="#8A8A85"
              BorderThickness="0" Padding="12,4"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="8,8,8,0" Click="MenuButton_Click"
              ToolTip="Menu — conversations, memory, tools, devices, activity, settings"/>
    </Grid>

    <!-- Conversation: the single ChatView, kept alive for the session. -->
    <ContentControl Grid.Row="2" x:Name="ChatArea"/>

    <!-- Overlay: minimal menu + the six sections, reusing the existing views. -->
    <Grid x:Name="Overlay" Grid.RowSpan="3" Background="#CC000000"
          Visibility="Collapsed" MouseLeftButtonDown="Overlay_MouseLeftButtonDown">
      <Border HorizontalAlignment="Right" Width="420" Background="{StaticResource BrushGlassFill}"
              BorderBrush="#D4AF37" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="16,12">
            <Button x:Name="OverlayBackButton" Content="‹ Menu"
                    Padding="8,4" Margin="0,0,12,0" Visibility="Collapsed"
                    Click="OverlayBackButton_Click"/>
            <TextBlock x:Name="OverlayTitle" Text="Menu" FontFamily="Georgia"
                       FontSize="18" FontWeight="Bold"
                       Foreground="#D4AF37" VerticalAlignment="Center"/>
            <Button Content="✕" Padding="8,4" HorizontalAlignment="Right"
                    Click="CloseOverlay_Click"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="OverlayContent" Margin="8,0,8,16"/>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
