<Window x:Class="Athena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATHENA" Height="700" Width="1100"
        MinHeight="560" MinWidth="900"
        Background="{StaticResource BrushBackground}"
        Icon="icon.png">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header: wordmark + connection status -->
    <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushGold}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <DockPanel>
        <TextBlock Text="ATHENA" FontFamily="Georgia"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource BrushGold}"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray"
                   Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12"
                     Foreground="{StaticResource BrushMuted}"
                     VerticalAlignment="Center"/>
          <Button x:Name="SetKeyButton" Content="Set key" Margin="16,0,0,0"
                  Padding="10,4" Click="SetKeyButton_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Main area: sidebar + content -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource BrushPanel}"
              BorderBrush="{StaticResource BrushGold}" BorderThickness="0,0,1,0">
        <StackPanel x:Name="NavPanel" Margin="0,8,0,8">
          <Button Tag="Dashboard" Content="Dashboard" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Chat" Content="Chat" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Conversations" Content="Conversations" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Memory Vault" Content="Memory Vault" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Tools" Content="Tools" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Devices" Content="Devices" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Activity" Content="Activity" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
          <Button Tag="Settings" Content="Settings" Click="NavButton_Click"
                  Background="Transparent"
                  Foreground="{StaticResource BrushMuted}"
                  FontSize="14" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,10,16,10" Margin="0,2,0,2"
                  BorderThickness="3,0,0,0" BorderBrush="Transparent"/>
        </StackPanel>
      </Border>

      <ContentControl Grid.Column="1" x:Name="ContentArea"/>
    </Grid>
  </Grid>
</Window>
