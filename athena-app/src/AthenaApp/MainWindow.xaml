<Window x:Class="Athena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATHENA" Height="640" Width="860"
        MinHeight="480" MinWidth="640"
        Background="{StaticResource BrushBackground}"
        Icon="icon.png">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: wordmark + connection status -->
    <Border Grid.Row="0" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushGold}" BorderThickness="0,0,0,1"
            Padding="16,10">
      <DockPanel>
        <TextBlock Text="ATHENA" FontFamily="Georgia"
                   FontSize="22" FontWeight="Bold"
                   Foreground="{StaticResource BrushGold}"
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray"
                   Margin="0,0,8,0"/>
          <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12"
                     Foreground="{StaticResource BrushMuted}"
                     VerticalAlignment="Center"/>
          <Button x:Name="SetKeyButton" Content="Set key" Margin="16,0,0,0"
                  Padding="10,4" Click="SetKeyButton_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Chat feed -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  Padding="16,8">
      <StackPanel x:Name="MessagesPanel"/>
    </ScrollViewer>

    <!-- Thinking indicator -->
    <TextBlock Grid.Row="2" x:Name="ThinkingText" Text="Athena is thinking…"
               FontSize="13" FontStyle="Italic"
               Foreground="{StaticResource BrushMuted}"
               Margin="16,0,16,8" Visibility="Collapsed"/>

    <!-- Input bar -->
    <Border Grid.Row="3" Background="{StaticResource BrushPanel}"
            BorderBrush="{StaticResource BrushGold}" BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox" Grid.Column="0" Margin="0,0,12,0"
                 KeyDown="InputBox_KeyDown"/>
        <Button x:Name="SendButton" Grid.Column="1" Content="Send"
                Click="SendButton_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
