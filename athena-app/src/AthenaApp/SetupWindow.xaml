<Window x:Class="Athena.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up ATHENA" Height="300" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BrushBackground}">
  <StackPanel Margin="20">
    <TextBlock Text="Your site key" FontSize="16" FontWeight="SemiBold"
               Foreground="{StaticResource BrushGold}" Margin="0,0,0,8"/>
    <TextBlock TextWrapping="Wrap" FontSize="13"
               Foreground="{StaticResource BrushMuted}" Margin="0,0,0,12">
      Paste the site key from your ATHENA website file (the VESPER_KEY value
      in vesper-cloud.html). It is checked once, then stored encrypted with
      Windows DPAPI on this computer only. It never leaves this computer
      except in the request header to your own backend, exactly as the
      website sends it.
    </TextBlock>
    <PasswordBox x:Name="KeyBox" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal">
      <Button x:Name="SaveButton" Content="Validate &amp; save"
              Click="SaveButton_Click"/>
      <Button Content="Cancel" Margin="12,0,0,0" Background="#2A2D33"
              Foreground="#F3F1EC" Click="CancelButton_Click"/>
    </StackPanel>
    <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13"
               Foreground="{StaticResource BrushMuted}" Margin="0,12,0,0"/>
  </StackPanel>
</Window>
