<UserControl x:Class="Athena.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#000000">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Chat feed -->
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                  Padding="16,8">
      <StackPanel x:Name="MessagesPanel"/>
    </ScrollViewer>

    <!-- Thinking / listening indicators -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,0,16,8">
      <TextBlock x:Name="ThinkingText" Text="Athena is thinking…"
                 FontSize="13" FontStyle="Italic"
                 Foreground="{StaticResource BrushMuted}"
                 Visibility="Collapsed"/>
      <TextBlock x:Name="ListeningText" Text="Listening… speak now, or tap Stop."
                 FontSize="13" FontStyle="Italic"
                 Foreground="{StaticResource BrushGold}"
                 Margin="16,0,0,0" Visibility="Collapsed"/>
    </StackPanel>

    <!-- Input bar: frosted glass panel. -->
    <Border Grid.Row="2" Background="{StaticResource BrushGlassFill}"
            BorderBrush="{StaticResource BrushGlassBorder}" BorderThickness="1"
            CornerRadius="10" Margin="16,0,16,12" Padding="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="InputBox" Grid.Column="0" Margin="0,0,12,0"
                 Background="Transparent" BorderThickness="0"
                 KeyDown="InputBox_KeyDown" TextChanged="InputBox_TextChanged"/>
        <Button x:Name="MicButton" Grid.Column="1" Content="Mic"
                Margin="0,0,8,0" Padding="10,4" IsEnabled="False"
                Click="MicButton_Click"
                ToolTip="Tap to speak — your words go into the box for you to check before sending."/>
        <Button x:Name="VoiceToggleButton" Grid.Column="2" Content="Voice: Off"
                Margin="0,0,8,0" Padding="10,4" IsEnabled="False"
                Click="VoiceToggleButton_Click"
                ToolTip="Read replies aloud with the female British voice. Off by default."/>
        <Button x:Name="SendButton" Grid.Column="3" Content="Send"
                Click="SendButton_Click"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
